{
  "name": "@laraxgram/vite",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Vite plugin for Luna.js with SSR dev mode support.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laraxgram/luna-js.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/laraxgram/luna-js/issues"
  },
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && ./build.js && tsc",
    "clean": "rm -rf types && rm -rf dist",
    "dev": "pnpx concurrently -c \"#ffcf00,#3178c6\" \"pnpm dev:build\" \"pnpm dev:types\" --names build,types",
    "dev:build": "./build.js --watch",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "dependencies": {
    "@laraxgram/luna": "workspace:*",
    "tinyglobby": "^0.2.15"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.13",
    "esbuild": "^0.28.1",
    "esbuild-node-externals": "^1.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  }
}
